# === GDS-Extraction — Example Configuration (v1.1 — vLLM Performance Fix) ===
# Copy to .env and adjust. Values here ARE the code defaults — keep them in sync.
# Model server is vLLM Qwen3.6-35B-A3B-NVFP4 on :8011 (E:\DGXSpark_Setup\vllm-qwen).
# This gateway never starts/kills the model — it only connects.
# If you migrated from llama.cpp :8006, delete your old .env or update MODEL_URL.

# === Model Server (vLLM, pre-existing) ===
MODEL_URL="http://127.0.0.1:8011/v1/chat/completions"
MODEL_NAME="Qwen3.6-35B-A3B-NVFP4"

# --- Context budget (MUST MATCH vLLM --max-model-len) ---
# vLLM uses continuous batching (no slot division). CONTEXT_SIZE = MAX_MODEL_LEN.
# MODEL_PARALLEL=1 means "no slots" — legacy :8006 used 4 slots.
#   Profile           CONTEXT_SIZE   MODEL_PARALLEL   Usable prompt room (3072 max_tokens)
#   vLLM default      32768          1                29440  (covers all GDS cases)
#   Large             65536          1                62208  (if you raise --max-model-len)
CONTEXT_SIZE="32768"
MODEL_PARALLEL="1"

# --- Output tokens (adaptive per-request, this is the default/baseline) ---
# Baseline 3072 + adaptive 1200+280*segments keeps Toby 2-seg ~1800 and golden 10-seg ~4000
# while preventing the old 8192 runaway (7k tokens → 103s at 68 tok/s).
MODEL_MAX_TOKENS="3072"

# Internal bearer token the gateway presents to vLLM. Sent ONLY if non-empty.
# vLLM default is empty (no auth). Set only if E:\DGXSpark_Setup\vllm-qwen\.env has API_KEY.
LLAMA_SERVER_API_KEY=""

# Sampling (FROZEN — greedy deterministic, do not change)
MODEL_TEMP="0.0"
MODEL_TOP_P="0.5"
MODEL_TOP_K="40"

# Thinking suppression: vLLM honors chat_template_kwargs:{enable_thinking:false} for Qwen3.6.
# Legacy :8006 also used reasoning_effort — code auto-detects via MODEL_URL.
DISABLE_THINKING="1"

# Optional guided JSON (xgrammar). 0=off (default, stable), 1=sends guided_json schema.
ENABLE_GUIDED_JSON="0"

# Request timeout per model call (seconds). 120 surfaces regressions faster than old 300.
REQUEST_TIMEOUT="120"

# Client-side context guard: strict (422 + guidance), warn (allow+log), off (testing).
CONTEXT_GUARD="strict"

# Batch concurrency (async). 1=sequential (default, safe), 2-4=parallel via asyncio.gather.
BATCH_CONCURRENCY="1"

# Streaming instrumentation (TTFT). 0=off (default), 1=enable stream=True + usage.
ENABLE_STREAMING="0"

# === Default YEAR for GDS dates that omit one ===
# Empty => CURRENT YEAR at request time (sentinel __DEFAULT_YEAR__ substituted per request).
DEFAULT_YEAR=""

# === GDS-Extraction API Service ===
API_PORT="8084"
API_HOST="0.0.0.0"
API_KEY_AUTH_HEADER="x-api-key"

# === API Keys (comma-separated) ===
API_KEYS="gds_key_0000:GDS Extraction Local Testing"
